#!/usr/bin/env bash
# scripts/hooks/commit-msg — DHX_RED_COMMIT audit trailer gate.
#
# Wired by scripts/install-hooks.sh's generic self-contained-hook sweep (any
# dot-free regular file directly under scripts/hooks/), so this file needs no
# installer edit — but it DOES need the installer to have been RUN. Adding the
# file is not deploying it: check #8d in verify-hook-patterns.sh refuses the
# opt-out outright when this hook is not wired, so the audit guarantee can never
# be silently absent while the bypass stays live.
#
# WHY A SECOND HOOK AT ALL. A pre-commit hook cannot see the commit message —
# git's order is pre-commit -> prepare-commit-msg -> commit-msg — so the only
# place a trailer can be required is here. Env vars propagate from `git commit`
# to every hook, so this gate reads DHX_RED_COMMIT the same way check #8d does.
#
# WHAT IT BUYS. `DHX_RED_COMMIT=1` is an environment variable and leaves no
# record. The 2026-08-23 audit of its five identifiable uses was only possible
# because four of them volunteered "(RED)" in the subject line; "how many, and
# why" was unanswerable for any commit that did not choose to say so. A gate
# whose bypass cannot be counted cannot be known to be working. With this
# trailer:
#
#     git log --grep='^DHX-Red-Commit:' --format='%h %ad %s%n  %b'
#
# It also writes a second trailer, DHX-Red-Probes:, carrying the roster of
# probes that were red — handed over from pre-commit check #8d through a
# sha-stamped file under the git dir. That roster is what lets check #8e enforce
# the paired GREEN cheaply (re-run those probes, seconds) instead of re-running
# the whole tier (~4 min) on every commit. It also answers "what was red", which
# the 2026-08-23 audit could not reconstruct for any historical use.
#
# Behaviour (inert unless DHX_RED_COMMIT=1):
#   trailer present with a non-empty reason  -> pass, untouched
#   trailer present but blank                -> BLOCK (a blank reason is no reason)
#   no trailer, DHX_RED_COMMIT_REASON set    -> append it, pass
#   no trailer, no reason                    -> BLOCK
#
# The append path is deliberate: check #8d already demands
# DHX_RED_COMMIT_REASON before it will run the tier, so by the time the message
# is written the operator has said why. Making them type it twice would be
# friction with no audit value — and friction on the sanctioned narrow opt-out
# is what pushes people to `--no-verify`, which is wider AND equally untraceable.
#
# Companion assertions: tests/probes/probe-red-commit-attribution.sh (cases 6-11).
# Backs: .planning/backlog/2026-08-23-red-commit-optout-is-a-general-untraceable-bypass.md

set -uo pipefail

MSG_FILE="${1:-}"
[ -n "$MSG_FILE" ] && [ -f "$MSG_FILE" ] || exit 0

# Inert for every ordinary commit.
[ "${DHX_RED_COMMIT:-0}" = "1" ] || exit 0

TRAILER_RE='^DHX-Red-Commit:[[:space:]]*[^[:space:]]'
ROSTER_RE='^DHX-Red-Probes:[[:space:]]*[^[:space:]]'

# ---- DHX-Red-Probes: the roster, handed over from pre-commit check #8d ------
#
# WHY. Check #8e enforces that the promised GREEN actually lands, and to do that
# cheaply it must know WHICH probes were red. Re-deriving that costs a ~4 min
# full-tier run on every commit; reading it from history costs nothing. #8d
# knows the roster (it just parsed run-probes.sh's `red:` lines) but cannot
# write the message; this hook can write the message but cannot see the roster.
# The handoff is a file under the git dir.
#
# THE SHA STAMP IS LOAD-BEARING. pre-commit can run without commit-msg ever
# following — an abandoned editor, a later check that refuses. The drop then
# survives on disk, and without a stamp it would attach a stale roster to some
# unrelated commit days later, inventing a debt that was never incurred. Line 1
# is the sha the roster was measured against; anything else is ignored.
#
# NOT DELETED after use, deliberately. Deleting on the success path alone would
# lose the roster whenever the reason-gate below refuses and the operator
# retries; deleting on every path loses it the same way. The stamp already makes
# the file self-invalidating — the next commit has a different HEAD — so leaving
# it is both simpler and the only variant with no retry hole.
# ---- append_trailer <key> <value> -------------------------------------------
# Git recognises trailers only as a CONTIGUOUS block in the message's last
# paragraph. Both appends below therefore have to share one separator rule, or
# the second one orphans the first: an unconditional "ensure a blank line
# first" sees the trailer the previous append just wrote, inserts a blank line
# after it, and splits the block in two. Git then parses only the final
# paragraph, and `git log --format=%(trailers:key=...)` returns EMPTY for the
# earlier trailer — which check #8e reads as "this RED commit recorded no
# roster", i.e. a debt it cannot re-check. Silent, and in the unsafe direction.
# Caught by probe-red-debt-pairing.sh D2 (the end-to-end case); the two hooks
# passed their own unit cases individually while the chain between them was
# broken, which is the whole reason that case exists.
append_trailer() {
    local key="$1" value="$2" last
    # 1. the file must end in a newline before anything is appended
    if [ -n "$(tail -c 1 "$MSG_FILE")" ]; then printf '\n' >> "$MSG_FILE"; fi
    last=$(tail -n 1 "$MSG_FILE")
    # 2. a blank line is needed ONLY when the message does not already end in a
    #    trailer block. Ending on a blank line needs nothing either.
    if [ -n "$last" ] && ! printf '%s' "$last" | grep -qE '^[A-Za-z][A-Za-z0-9-]*:[[:space:]]'; then
        printf '\n' >> "$MSG_FILE"
    fi
    printf '%s: %s\n' "$key" "$value" >> "$MSG_FILE"
}

_rd_pending="$(git rev-parse --git-dir 2>/dev/null || echo .git)/dhx-red-probes.pending"
if [ -f "$_rd_pending" ] && ! grep -qE "$ROSTER_RE" "$MSG_FILE"; then
    _rd_stamp=$(head -1 "$_rd_pending" 2>/dev/null || echo "")
    _rd_head=$(git rev-parse HEAD 2>/dev/null || echo "none")
    if [ -n "$_rd_stamp" ] && [ "$_rd_stamp" = "$_rd_head" ]; then
        _rd_list=$(tail -n +2 "$_rd_pending" 2>/dev/null | tr '\n' ' ' | sed 's/[[:space:]]*$//')
        if [ -n "$_rd_list" ]; then
            append_trailer "DHX-Red-Probes" "$_rd_list"
            echo "DHX-Red-Probes trailer appended ($_rd_list)."
        fi
    fi
fi

refuse() {
  echo "" >&2
  echo "BLOCKED: this commit sets DHX_RED_COMMIT=1 and needs a DHX-Red-Commit: <reason> trailer." >&2
  echo "  $1" >&2
  echo "" >&2
  echo "  The opt-out is an environment variable and leaves no record. The trailer is" >&2
  echo "  what makes it countable:" >&2
  echo "    git log --grep='^DHX-Red-Commit:'" >&2
  echo "" >&2
  echo "  Either add the trailer to the message body:" >&2
  echo "    DHX-Red-Commit: probe asserts machinery that lands in the paired GREEN" >&2
  echo "  or export the reason and let this hook write it for you:" >&2
  echo "    DHX_RED_COMMIT=1 DHX_RED_COMMIT_REASON='<why>' git commit ..." >&2
  echo "" >&2
  exit 1
}

if grep -qE "$TRAILER_RE" "$MSG_FILE"; then
  exit 0
fi

if grep -qE '^DHX-Red-Commit:' "$MSG_FILE"; then
  refuse "A DHX-Red-Commit: trailer is present but its reason is empty."
fi

if [ -n "${DHX_RED_COMMIT_REASON:-}" ]; then
  append_trailer "DHX-Red-Commit" "$DHX_RED_COMMIT_REASON"
  echo "DHX-Red-Commit trailer appended from DHX_RED_COMMIT_REASON."
  exit 0
fi

refuse "No DHX-Red-Commit: trailer, and DHX_RED_COMMIT_REASON is unset."
